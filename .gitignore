## .gitignore for DatabaseTool (.NET 8 / ASP.NET Core / Blazor Server)
## Based on the standard Dotnet.gitignore with project-specific additions.
## https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# ── Build output ────────────────────────────────────────────────────────────
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ── Publish output (dotnet publish) ─────────────────────────────────────────
# Generated by the IIS_EC2 publish profile (src/DatabaseTool.Web/publish/)
publish/
[Pp]ublish/

# ── .NET / NuGet ────────────────────────────────────────────────────────────
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg
.nuget/

# ── ASP.NET Core ─────────────────────────────────────────────────────────────
ScaffoldingReadMe.txt

# Developer-local settings — may contain connection strings or secrets.
# Keep appsettings.json and appsettings.Production.json tracked.
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json

# ASP.NET Core HTTPS dev certificate (never commit private keys)
*.pfx
*.p12
*.cer

# ── Runtime-generated config (project-specific) ──────────────────────────────
# typemapping.json is written by TypeMappingService at runtime.
# Each deployment has its own overrides; do not share via source control.
typemapping.json

# ── Visual Studio ────────────────────────────────────────────────────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# ── Rider / ReSharper ────────────────────────────────────────────────────────
.idea/
*.sln.iml
_ReSharper*/
*.DotSettings

# ── VS Code ──────────────────────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── Cursor IDE ───────────────────────────────────────────────────────────────
# Keep .cursor/plans/ tracked (shared planning docs).
# Exclude agent transcripts (large JSONL files, not useful in history)
# and the plugin cache (regenerated on demand).
.cursor/projects/
.cursor/plugins/cache/

# ── Test results / Coverage ──────────────────────────────────────────────────
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage/
coverlet/
CodeCoverage/
*.coverage
*.coveragexml
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ── MSBuild ──────────────────────────────────────────────────────────────────
*.binlog

# ── OS-generated files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
~$*
*~

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
secrets.json
**/secrets.json

# ── Libman (client-side library manager) ─────────────────────────────────────
# Uncomment if you use Libman to restore Bootstrap/etc.
# wwwroot/lib/
