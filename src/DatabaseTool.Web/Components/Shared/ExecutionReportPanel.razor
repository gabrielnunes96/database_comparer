@using DatabaseTool.Core.Execution

<div class="card @(Report.HasErrors ? "border-danger" : "border-success")">
    <div class="card-header d-flex justify-content-between align-items-center @(Report.HasErrors ? "bg-danger-subtle" : "bg-success-subtle")">
        <span class="fw-semibold">@Title</span>
        <div class="d-flex gap-2 align-items-center">
            @if (Report.IsDryRun)
            {
                <span class="badge bg-info">DRY RUN</span>
            }
            <span class="badge @(Report.AllSucceeded ? "bg-success" : "bg-danger")">
                @Report.SuccessCount / @Report.Statements.Count passed
            </span>
            <span class="text-muted small">@Report.Duration.TotalSeconds.ToString("F2")s</span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 400px; overflow: auto;">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th style="width:40px">#</th>
                        <th style="width:70px">Status</th>
                        <th>Statement</th>
                        <th style="width:80px">Duration</th>
                        <th style="width:80px">Rows</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stmt in Report.Statements)
                    {
                        <tr class="@(stmt.Success ? "" : "table-danger")">
                            <td>@(stmt.Index + 1)</td>
                            <td>
                                @if (stmt.Success)
                                {
                                    <span class="badge bg-success">OK</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">FAIL</span>
                                }
                            </td>
                            <td>
                                <code class="small text-truncate d-block" style="max-width:600px" title="@stmt.Statement">
                                    @(stmt.Statement.Length > 120 ? stmt.Statement[..120] + "..." : stmt.Statement)
                                </code>
                                @if (!stmt.Success && !string.IsNullOrEmpty(stmt.ErrorMessage))
                                {
                                    <div class="text-danger small mt-1">@stmt.ErrorMessage</div>
                                }
                            </td>
                            <td class="small text-muted">@stmt.Duration.TotalMilliseconds.ToString("F0")ms</td>
                            <td class="small">@stmt.RowsAffected</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (ShowConfirm && !Report.HasErrors && OnConfirmExecute.HasDelegate)
    {
        <div class="card-footer">
            <div class="alert alert-success py-2 mb-2">
                <i class="bi bi-check-circle-fill me-2"></i>
                Dry-run succeeded! All @Report.Statements.Count statements would execute without errors.
            </div>
            <button class="btn btn-danger" @onclick="OnConfirmExecute">
                <i class="bi bi-play-fill me-1"></i> Execute for Real
            </button>
        </div>
    }
    else if (Report.HasErrors)
    {
        <div class="card-footer">
            <div class="alert alert-danger py-2 mb-0">
                <i class="bi bi-x-circle-fill me-2"></i>
                @Report.ErrorCount statement(s) failed. Fix errors before executing.
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ExecutionReport Report { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "Execution Report";
    [Parameter] public bool ShowConfirm { get; set; }
    [Parameter] public EventCallback OnConfirmExecute { get; set; }
}
