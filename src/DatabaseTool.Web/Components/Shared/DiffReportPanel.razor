@using DatabaseTool.Core.Diff
@using DatabaseTool.Core.Models
@using DatabaseTool.Web.Components.Shared

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
        Diff Report
        <div class="d-flex gap-2">
            <span class="badge @(Report.HasDifferences ? "bg-warning text-dark" : "bg-success")">
                @(Report.HasDifferences ? $"{Report.TotalDifferences} difference(s)" : "In Sync")
            </span>
            @if (Report.HasDifferences)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="OnGenerateSyncScript">
                    <i class="bi bi-code"></i> Generate Sync Script
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="OnDownloadReport">
                    <i class="bi bi-download"></i> Download Report
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Source: <strong>@Report.Source.SourceDescription</strong> &nbsp;vs&nbsp;
            Target: <strong>@Report.Target.SourceDescription</strong>
        </p>

        <DiffSection Title="Tables" Icon="bi-table" Section="@TableSection" />
        <DiffSection Title="Views" Icon="bi-eye" Section="@ViewSection" />
        <DiffSection Title="Procedures" Icon="bi-cpu" Section="@ProcSection" />
        <DiffSection Title="Functions" Icon="bi-braces" Section="@FuncSection" />
        <DiffSection Title="Triggers" Icon="bi-lightning" Section="@TrigSection" />
    </div>
</div>

@code {
    [Parameter] public DiffReport Report { get; set; } = null!;
    [Parameter] public EventCallback OnGenerateSyncScript { get; set; }
    [Parameter] public EventCallback OnDownloadReport { get; set; }

    private DiffSectionData TableSection => new()
    {
        OnlyInSource = Report.Tables.OnlyInSource,
        OnlyInTarget = Report.Tables.OnlyInTarget,
        Different = Report.Tables.Different.Select(d => d.TableName + " (" + d.ColumnDiffs.Count + " col diff(s))").ToList()
    };

    private DiffSectionData ViewSection => SimpleSectionData(Report.Views);
    private DiffSectionData ProcSection => SimpleSectionData(Report.Procedures);
    private DiffSectionData FuncSection => SimpleSectionData(Report.Functions);
    private DiffSectionData TrigSection => SimpleSectionData(Report.Triggers);

    private static DiffSectionData SimpleSectionData(SectionDiff<ObjectDiff> section) => new()
    {
        OnlyInSource = section.OnlyInSource,
        OnlyInTarget = section.OnlyInTarget,
        Different = section.Different.Select(d => d.ObjectName).ToList()
    };
}
