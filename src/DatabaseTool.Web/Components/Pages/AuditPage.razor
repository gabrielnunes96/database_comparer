@page "/audit"
@inherits LocalizedComponentBase
@inject AuditService AuditService
@rendermode InteractiveServer

<PageTitle>@L["audit.title"]</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>@L["audit.title"]</h2>
            <p class="text-muted mb-0">@L["audit.subtitle"]</p>
        </div>
        <button class="btn btn-outline-danger btn-sm" @onclick="ClearLog">@L["audit.clear"]</button>
    </div>

    @{
        var entries = AuditService.GetEntries().OrderByDescending(e => e.Timestamp).ToList();
    }

    @if (!entries.Any())
    {
        <div class="alert alert-info">@L["audit.empty"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>@L["audit.timestamp"]</th>
                        <th>@L["audit.action"]</th>
                        <th>@L["audit.source"]</th>
                        <th>@L["audit.target"]</th>
                        <th>@L["audit.status"]</th>
                        <th>@L["audit.details"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in entries)
                    {
                        <tr>
                            <td class="text-nowrap small">@entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge bg-primary">@entry.Action</span></td>
                            <td class="small">@entry.SourceDescription</td>
                            <td class="small">@entry.TargetDescription</td>
                            <td>
                                @if (entry.Success)
                                {
                                    <span class="badge bg-success">@L["audit.success"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@L["audit.failed"]</span>
                                }
                            </td>
                            <td class="small text-muted">@entry.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small">@entries.Count @L["audit.entries"]</p>
    }
</div>

@code {
    private void ClearLog() => AuditService.Clear();
}
