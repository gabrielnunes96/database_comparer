@page "/comparator"
@inherits LocalizedComponentBase
@inject SchemaService SchemaService
@inject AuditService AuditService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>@L["comparator.title"]</PageTitle>

<div class="container-fluid py-3">
    <h2>@L["comparator.title"]</h2>
    <p class="text-muted">@L["comparator.subtitle"]</p>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible">
            @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-semibold">@L["comparator.sourceA"]</div>
                <div class="card-body">
                    <SourceSelector @bind-Dialect="_dialectA"
                                    @bind-InputMode="_inputModeA"
                                    @bind-ConnectionString="_connStrA"
                                    @bind-SqlContent="_sqlContentA"
                                    OnObjectsLoaded="_ => { }"
                                    Label="A" />
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-semibold">@L["comparator.sourceB"]</div>
                <div class="card-body">
                    <SourceSelector @bind-Dialect="_dialectB"
                                    @bind-InputMode="_inputModeB"
                                    @bind-ConnectionString="_connStrB"
                                    @bind-SqlContent="_sqlContentB"
                                    OnObjectsLoaded="_ => { }"
                                    Label="B" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button class="btn btn-primary" @onclick="RunComparison" disabled="@_isRunning">
            @if (_isRunning) { <span class="spinner-border spinner-border-sm me-2"></span> }
            @(_isRunning ? L["general.running"] : L["comparator.compare"])
        </button>
    </div>

    @if (_report is not null)
    {
        <DiffReportPanel Report="_report"
                          OnGenerateSyncScript="GenerateSyncScript"
                          OnDownloadReport="DownloadReport" />
    }

    @if (!string.IsNullOrEmpty(_syncScript))
    {
        <div class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
                @L["comparator.syncScript"]
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadSyncScript">
                        <i class="bi bi-download"></i> @L["comparator.download"]
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <pre class="m-0 p-3" style="max-height:400px; overflow:auto; font-size:.8rem; background:#1e1e1e; color:#d4d4d4;">@_syncScript</pre>
            </div>
        </div>
    }
</div>

@code {
    private DatabaseDialect _dialectA = DatabaseDialect.SqlServer;
    private string _inputModeA = "connection";
    private string _connStrA = string.Empty;
    private string _sqlContentA = string.Empty;

    private DatabaseDialect _dialectB = DatabaseDialect.PostgreSQL;
    private string _inputModeB = "connection";
    private string _connStrB = string.Empty;
    private string _sqlContentB = string.Empty;

    private bool _isRunning;
    private string? _errorMessage;
    private DatabaseTool.Core.Diff.DiffReport? _report;
    private string _syncScript = string.Empty;

    private async Task RunComparison()
    {
        _isRunning = true;
        _errorMessage = null;
        _report = null;
        _syncScript = string.Empty;

        try
        {
            var options = ExtractionOptions.All;
            SchemaModel schemaA, schemaB;

            if (_inputModeA == "connection")
                schemaA = await SchemaService.ExtractFromConnectionAsync(_connStrA, _dialectA, options);
            else
                schemaA = await SchemaService.ExtractFromFileAsync(_sqlContentA, _dialectA, options);

            if (_inputModeB == "connection")
                schemaB = await SchemaService.ExtractFromConnectionAsync(_connStrB, _dialectB, options);
            else
                schemaB = await SchemaService.ExtractFromFileAsync(_sqlContentB, _dialectB, options);

            _report = SchemaService.Compare(schemaA, schemaB);
            AuditService.Log("Compare", schemaA.SourceDescription, schemaB.SourceDescription, true,
                $"{_report.TotalDifferences} difference(s) found");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isRunning = false;
        }
    }

    private void GenerateSyncScript()
    {
        if (_report is null) return;
        _syncScript = SchemaService.GenerateSyncScript(_report);
    }

    private async Task DownloadReport()
    {
        if (_report is null) return;
        var html = BuildHtmlReport(_report);
        var bytes = System.Text.Encoding.UTF8.GetBytes(html);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFile", base64, $"diff_report_{DateTime.UtcNow:yyyyMMdd_HHmmss}.html");
    }

    private async Task DownloadSyncScript()
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(_syncScript);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFile", base64, $"sync_script_{DateTime.UtcNow:yyyyMMdd_HHmmss}.sql");
    }

    private static string BuildHtmlReport(DatabaseTool.Core.Diff.DiffReport report)
    {
        return $@"<!DOCTYPE html><html><head><title>Diff Report</title>
<link href=""https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/css/bootstrap.min.css"" rel=""stylesheet""></head>
<body class=""container py-4"">
<h1>Schema Diff Report</h1>
<p>Generated: {report.GeneratedAt:yyyy-MM-dd HH:mm:ss} UTC</p>
<p>Source: {report.Source.SourceDescription} vs Target: {report.Target.SourceDescription}</p>
<p>Total differences: {report.TotalDifferences}</p>
</body></html>";
    }
}
