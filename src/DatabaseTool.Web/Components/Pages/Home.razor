@page "/"
@inherits LocalizedComponentBase
@rendermode InteractiveServer

<PageTitle>@L["home.title"]</PageTitle>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold">@L["home.title"]</h1>
            <p class="lead text-muted">@L["home.subtitle"]</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-arrow-left-right text-primary me-2"></i> @L["home.card.converter.title"]
                    </h5>
                    <p class="card-text text-muted">@L["home.card.converter.desc"]</p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/converter" class="btn btn-primary w-100">@L["home.card.open"]</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-file-diff text-success me-2"></i> @L["home.card.comparator.title"]
                    </h5>
                    <p class="card-text text-muted">@L["home.card.comparator.desc"]</p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/comparator" class="btn btn-success w-100">@L["home.card.open"]</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-code-square text-warning me-2"></i> @L["home.card.query.title"]
                    </h5>
                    <p class="card-text text-muted">@L["home.card.query.desc"]</p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/query-converter" class="btn btn-warning w-100">@L["home.card.open"]</a>
                </div>
            </div>
        </div>
    </div>
</div>
